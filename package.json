{
  "name": "wimzo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node scripts/wimzo.mjs serve --dashboard",
    "cli": "node src/cli.ts",
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "setup": "node scripts/setup.ts",
    "demo": "node scripts/demo.ts",
