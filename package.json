    "@earendil-works/pi-coding-agent": "0.87.1",
    "@openai/codex-sdk": "0.155.1",
    "marked": "17.0.4"
  },
  "overrides": {
    "undici": "^8.9.0",
    "brace-expansion": "^5.0.9",
    "protobufjs": "^7.6.5"
  }
